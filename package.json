{
  "name": "business-management-system",
  "version": "0.1.0",
  "description": "Kayani Autos / Kiyan Traders offline-first ERP/POS system",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:dev": "tsx src/db/seed-dev-data.ts",
    "db:seed:car-makes": "tsx src/db/seed-car-makes.ts",
    "typecheck": "tsc --noEmit",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.12.3",
    "fastify-type-provider-zod": "^7.0.0",
    "postgres": "^3.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuidv7": "^1.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kayaniautos/Business-Management-System.git"
  }
}
